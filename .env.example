# Where the web app's server reaches the API (server-side only, never sent to browsers).
API_INTERNAL_URL="https://edimartapi-1.onrender.com"
# Public URL of the API; used for product image links.
NEXT_PUBLIC_API_URL="https://edimartapi-1.onrender.com"
# Name of the httpOnly login cookie.
AUTH_COOKIE_NAME="edisims_access"
# Only when the API uses STORAGE_DRIVER=s3: the public URL of the image bucket / CDN
# (the same value as the API's S3_PUBLIC_BASE_URL), so next/image may load product photos from it.
# NEXT_PUBLIC_IMAGE_BASE_URL="https://img.example.com"
# How long a login lasts is set on the API (SESSION_TTL_HOURS); the cookie follows it.
